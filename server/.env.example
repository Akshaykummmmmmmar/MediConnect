PORT=4000
DB_URI=mongodb://localhost:27017/projectdb
# Required. Use a long random string (>=32 chars). The server refuses to start
# in production when this is missing.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Gmail SMTP. Use a Google App Password (not your normal Google password).
# Create it at https://myaccount.google.com/apppasswords after enabling 2-Step Verification.
# Do not commit the real server/.env file or share the App Password.
# Security: OTP and password-reset tokens are NEVER returned in API responses.
# When MAIL_ENABLED=false the email content (including OTP/tokens) is printed to
# the server console only, which is fine for local development.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-google-account@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=MediConnect <your-google-account@gmail.com>